diff --git a/SpaceCadetPinball/cadet_bridge.cpp b/SpaceCadetPinball/cadet_bridge.cpp
new file mode 100644
index 0000000..f66dd11
--- /dev/null
+++ b/SpaceCadetPinball/cadet_bridge.cpp
@@ -0,0 +1,207 @@
+// USER_HOUSE browser integration. MIT, same terms as the engine.
+#include "pch.h"
+#include "pb.h"
+#include "winmain.h"
+#include "options.h"
+#include "render.h"
+#include "pinball.h"
+#include "Sound.h"
+#include "TPinballTable.h"
+#include "TPinballComponent.h"
+#include "TTextBox.h"
+#include "TBall.h"
+#include "score.h"
+#include "timer.h"
+#include "TPlunger.h"
+#include "TFlipper.h"
+#include "TFlipperEdge.h"
+#include <emscripten.h>
+#include <sstream>
+#include <cmath>
+
+namespace {
+bool ready = false;
+bool loopRegistered = false;
+bool loopSleeping = false;
+bool requestedPause = true;
+bool held[6]{};
+double lastTick = 0;
+double remainderMs = 0;
+unsigned long ticks = 0;
+std::string snapshot;
+int keyFor(int action) {
+    switch (action) {
+    case 0: return options::Options.LeftFlipperKey;
+    case 1: return options::Options.RightFlipperKey;
+    case 2: return options::Options.PlungerKey;
+    case 3: return options::Options.LeftTableBumpKey;
+    case 4: return options::Options.RightTableBumpKey;
+    case 5: return options::Options.BottomTableBumpKey;
+    default: return 0;
+    }
+}
+void releaseAll() {
+    for (int i = 0; i < 6; ++i) { pb::keyup(keyFor(i)); held[i] = false; }
+}
+std::string quote(const char* value) {
+    std::string result = "\"";
+    if (value) for (const unsigned char* p = (const unsigned char*)value; *p; ++p) {
+        switch (*p) {
+        case '\\': result += "\\\\"; break;
+        case '"': result += "\\\""; break;
+        case '\n': result += "\\n"; break;
+        case '\r': result += "\\r"; break;
+        case '\t': result += "\\t"; break;
+        default: if (*p >= 32 && *p < 128) result += *p; else { char escaped[7]; snprintf(escaped, sizeof escaped, "\\u%04x", *p); result += escaped; }
+        }
+    }
+    return result + "\"";
+}
+const char* textOf(TTextBox* box) { return box && box->Message1 ? box->Message1->Text : ""; }
+int countLights(const char* name) {
+    auto component = pb::MainTable->find_component(name);
+    return component ? component->Message(37, 0.0f) : 0;
+}
+void tick() {
+    const double now = emscripten_get_now();
+    double elapsed = lastTick ? now - lastTick : 0;
+    lastTick = now;
+    winmain::ProcessWindowMessages();
+    // The host owns pause and focus. Touch controls live outside this iframe;
+    // focusing them must not suspend the table or lose a held flipper.
+    if ((winmain::single_step != 0) != requestedPause) pb::pause_continue();
+    if (!requestedPause) {
+        // Keep physics tied to elapsed time at low display refresh rates. Short
+        // steps preserve collision/target processing; long background gaps drop.
+        if (elapsed > 1000 || elapsed < 0) elapsed = 0;
+        remainderMs += std::min(elapsed, 250.0);
+        while (remainderMs >= 8) { pb::frame(8); remainderMs -= 8; ++ticks; }
+    } else remainderMs = 0;
+    SDL_RenderClear(winmain::Renderer);
+    render::PresentVScreen();
+    SDL_RenderPresent(winmain::Renderer);
+    if(requestedPause && loopRegistered && !loopSleeping) {
+        emscripten_pause_main_loop();
+        loopSleeping=true;
+    }
+}
+}
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE int cadet_ready() { return ready; }
+EMSCRIPTEN_KEEPALIVE void cadet_new_game() {
+    if (!ready) return;
+    releaseAll();
+    options::Options.Players = 1;
+    if (winmain::single_step) pb::pause_continue();
+    pb::replay_level(0);
+    requestedPause = false;
+    lastTick = emscripten_get_now();
+    remainderMs = 0;
+    Sound::Activate();
+    if(loopRegistered && loopSleeping) { loopSleeping=false; emscripten_resume_main_loop(); }
+}
+// A deliberate new-ball checkpoint, not a full mission/physics snapshot.
+EMSCRIPTEN_KEEPALIVE void cadet_restore_checkpoint(double savedScore, int lives, int rank, int progress) {
+    if (!ready || !std::isfinite(savedScore)) return;
+    cadet_new_game();
+    auto table=pb::MainTable;
+    // Finish the new-game light show before applying restored rank lamps; its
+    // delayed reset would otherwise clear them after this function returns.
+    if(table->LightShowTimer) {
+        timer::kill(table->LightShowTimer);
+        TPinballTable::LightShow_timeout(0,table);
+    }
+    const long long total=static_cast<long long>(std::max(0.0, std::min(savedScore, 9999999999.0)));
+    table->CurScore=static_cast<int>(total%1000000000LL);
+    table->CurScoreE9=static_cast<int>(total/1000000000LL);
+    table->PlayerScores[0].Score=table->CurScore;
+    table->PlayerScores[0].ScoreE9Part=table->CurScoreE9;
+    score::set(table->CurScoreStruct,table->CurScore);
+    score::update(table->CurScoreStruct);
+    table->ChangeBallCount(std::max(1,std::min(lives,3)));
+    table->PlayerScores[0].BallCount=table->BallCount;
+    const char* names[]={"middle_circle","outer_circle"};
+    const int counts[]={std::max(1,std::min(rank,9)),std::max(0,std::min(progress,24))};
+    for(int i=0;i<2;++i) {
+        auto group=table->find_component(names[i]);
+        if(!group) continue;
+        group->Message(34,0.0f);
+        group->Message(0,0.0f);
+        for(int j=0;j<counts[i];++j) group->Message(32,0.0f);
+    }
+}
+EMSCRIPTEN_KEEPALIVE void cadet_input(int action, int down) {
+    if (!ready || action < 0 || action > 5 || (down && requestedPause)) return;
+    if (held[action] == (down != 0)) return;
+    held[action] = down != 0;
+    if (down) { Sound::Activate(); pb::keydown(keyFor(action)); }
+    else pb::keyup(keyFor(action));
+}
+EMSCRIPTEN_KEEPALIVE void cadet_set_paused(int paused) {
+    requestedPause = paused != 0;
+    if (!ready) return;
+    if (requestedPause) releaseAll();
+    if ((winmain::single_step != 0) != requestedPause) pb::pause_continue();
+    lastTick = emscripten_get_now();
+    remainderMs = 0;
+    if(loopRegistered) {
+        if(requestedPause && !loopSleeping) { emscripten_pause_main_loop(); loopSleeping=true; }
+        else if(!requestedPause && loopSleeping) { loopSleeping=false; emscripten_resume_main_loop(); }
+    }
+}
+EMSCRIPTEN_KEEPALIVE void cadet_set_muted(int muted) {
+    if (!ready) return;
+    options::Options.Sounds = muted ? 0 : 1;
+    Sound::Enable(0, 7, options::Options.Sounds);
+}
+EMSCRIPTEN_KEEPALIVE const char* cadet_snapshot() {
+    if (!ready || !pb::MainTable) return "{\"ready\":false}";
+    auto table = pb::MainTable;
+    auto mission = table->find_component("lite198");
+    SDL_RendererInfo rendererInfo{};
+    SDL_GetRendererInfo(winmain::Renderer,&rendererInfo);
+    std::ostringstream out;
+    out << "{\"ready\":true,\"renderer\":" << quote(rendererInfo.name) << ",\"score\":" << (static_cast<long long>(table->CurScoreE9)*1000000000LL+table->CurScore)
+        << ",\"lives\":" << table->BallCount << ",\"extraBalls\":" << table->ExtraBalls
+        << ",\"gameover\":" << (pb::game_mode == 2 ? "true" : "false")
+        << ",\"paused\":" << (requestedPause ? "true" : "false")
+        << ",\"gameMode\":" << pb::game_mode << ",\"rank\":" << countLights("middle_circle")
+        << ",\"rankProgress\":" << countLights("outer_circle")
+        << ",\"missionId\":" << (mission ? mission->MessageField : 0)
+        << ",\"mission\":" << quote(textOf(pinball::MissTextBox))
+        << ",\"info\":" << quote(textOf(pinball::InfoTextBox))
+        << ",\"tilted\":" << (table->TiltLockFlag ? "true" : "false")
+        << ",\"multiplier\":" << table->ScoreMultiplier
+        << ",\"plungerBoost\":" << table->Plunger->Boost
+        << ",\"plungerMax\":" << table->Plunger->MaxPullback
+        << ",\"plungerIncrement\":" << table->Plunger->PullbackIncrement
+        << ",\"components\":" << table->ComponentList->GetCount()
+        << ",\"elapsedMs\":" << pb::time_ticks << ",\"ticks\":" << ticks
+        << ",\"tableRect\":{\"x\":0,\"y\":0,\"width\":" << table->Width << ",\"height\":" << table->Height << "}"
+        << ",\"left\":" << table->FlipperL->FlipperEdge->flipper_angle(pb::time_now)
+        << ",\"right\":" << table->FlipperR->FlipperEdge->flipper_angle(pb::time_now)
+        << ",\"inputs\":[";
+    for (int i=0;i<6;++i) { if(i) out << ','; out << (held[i] ? "true" : "false"); }
+    out << "],\"balls\":[";
+    for(int i=0;i<table->BallList->GetCount();++i) {
+        auto ball=table->BallList->Get(i); if(i) out << ',';
+        out << "{\"active\":" << (ball->ActiveFlag ? "true" : "false") << ",\"x\":" << ball->Position.X << ",\"y\":" << ball->Position.Y << ",\"z\":" << ball->Position.Z << ",\"speed\":" << ball->Speed << ",\"vx\":" << ball->Acceleration.X * ball->Speed << ",\"vy\":" << ball->Acceleration.Y * ball->Speed << '}';
+    }
+    out << "]}";
+    snapshot=out.str();
+    return snapshot.c_str();
+}
+}
+
+void cadet_start_web_loop() {
+    SDL_SetWindowSize(winmain::MainWindow, pb::MainTable->Width, pb::MainTable->Height);
+    EM_ASM({Module.canvas.width=$0; Module.canvas.height=$1;}, pb::MainTable->Width, pb::MainTable->Height);
+    options::Options.Players = 1;
+    options::Options.Music = 0;
+    ready = true;
+    cadet_set_paused(requestedPause);
+    // RAF chooses display cadence; simulation uses elapsed wall-clock time.
+    loopRegistered=true;
+    emscripten_set_main_loop(tick, 0, true);
+}
